# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# === AWS S3 STORAGE ===
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name

# === AI SERVICE PROVIDER CONFIGURATION ===
# Choose provider: 'huggingface' (FREE), 'openai' (PAID), 'replicate' (PAID)
GENERATION_PROVIDER=huggingface
VISION_PROVIDER=gemini

# === VISION/ANALYSIS APIs ===
# Google Gemini (FREE tier available) - For image analysis
GOOGLE_API_KEY=your_google_api_key

# === IMAGE GENERATION APIs ===
# Hugging Face (FREE tier available) - For Stable Diffusion
HF_TOKEN=your_huggingface_token

# OpenAI (PAID) - For DALL-E 3 and variations (optional)
# OPENAI_API_KEY=your_openai_api_key

# Replicate (PAID) - For advanced models (optional)
# REPLICATE_API_TOKEN=your_replicate_token

# === NOTES ===
# FREE TIER RECOMMENDATION:
# - VISION_PROVIDER=gemini (Google Gemini offers free tier)
# - GENERATION_PROVIDER=huggingface (Stable Diffusion XL via HF Inference API)
#
# For image variations with free tier:
# - Uses smart workaround: Gemini analyzes image + Stable Diffusion generates variation
# - Not true img2img, but works well for demo purposes
#
# PAID TIER (For production):
# - GENERATION_PROVIDER=openai (for true DALL-E variations)
# - Or use Replicate for advanced img2img models
